# 邮件配置示例文件
# 复制此文件为 .env 并填写您的配置

# SMTP服务器配置（使用Gmail）
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# 发送邮箱账号（建议创建一个专用的Gmail账号）
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# 接收提醒的邮箱地址
ALERT_EMAIL=your_alert_email@example.com

# 外部网站监控（website_monitor.py，可选）
WEBSITE_URL=https://retailgo2048.com
MONITOR_URL=https://retailgo2048.com/healthz
CHECK_INTERVAL=300

# 注意事项：
# 1. Gmail需要开启"两步验证"并创建"应用专用密码"
# 2. 不要将真实密码提交到Git
# 3. 在VPS上配置环境变量：export SMTP_USERNAME=xxx
